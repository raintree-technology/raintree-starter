# ---------------------------------------------------------------------------
# Copy to `.env` for local development. Never commit real secrets.
# Configure only the integrations enabled in `starter.config.ts`.
# ---------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3450
DEPLOYMENT_ENV=development
# Required in production; previews must use a different origin.
CANONICAL_APP_URL=

# --- Neon Postgres and Drizzle ---
# Required: Neon pooled Postgres connection string.
DATABASE_URL=
# Optional: Migration-owner connection string; required for hosted deployments.
DIRECT_DATABASE_URL=

# --- Better Auth ---
# Required: 32-byte secret for Better Auth session signing.
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Dedicated Better Auth database role; required for hosted deployments.
AUTH_DATABASE_URL=
# Optional: Public auth base URL. Defaults to NEXT_PUBLIC_APP_URL.
# Example: http://localhost:3450
BETTER_AUTH_URL=

# --- Google and GitHub OAuth ---
# Optional: Google OAuth client id.
GOOGLE_CLIENT_ID=
# Optional: Google OAuth client secret.
GOOGLE_CLIENT_SECRET=
# Optional: GitHub OAuth client id.
GITHUB_CLIENT_ID=
# Optional: GitHub OAuth client secret.
GITHUB_CLIENT_SECRET=

# --- Resend Email ---
# Optional: Resend API key. Missing keys log emails in development.
RESEND_API_KEY=
# Optional: Transactional sender address.
# Example: Acme <onboarding@resend.dev>
EMAIL_FROM=

# --- Upstash Rate Limiting ---
# Optional: Upstash Redis REST URL.
UPSTASH_REDIS_REST_URL=
# Optional: Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
# Optional: Set to 1 to store Upstash rate-limit analytics.
UPSTASH_RATELIMIT_ANALYTICS=
# Optional: Set to 1 to enable Upstash deny-list protection for identifiers and IPs.
UPSTASH_RATELIMIT_PROTECTION=
