{
  "name": "next-starter",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1 --port 3450",
    "build": "next build",
    "build:ci": "DATABASE_URL=postgresql://user:password@localhost:55200/ci BETTER_AUTH_SECRET=ci-build-only-not-a-real-secret-32-chars NEXT_PUBLIC_APP_URL=http://localhost:3450 bun run build",
    "start": "next start --hostname 127.0.0.1 --port 3450",
    "lint": "bun run check:biome && eslint .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "deps:outdated": "bun outdated",
    "deps:update": "bun update",
    "validate": "bun run lint && bun run typecheck && bun run architecture:check && bun run test",
    "architecture:check": "node scripts/check-architecture.mjs",
    "validate:security": "bun run audit",
    "validate:full": "bun run validate && bun run validate:security && bun run build:ci && bun run test:e2e",
    "test": "vitest run",
    "test:unit": "bun run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun scripts/agent-browser-smoke.ts",
    "test:e2e:ui": "AGENT_BROWSER_KEEP_OPEN=1 bun scripts/agent-browser-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:role:check": "bun scripts/check-database-role.ts",
    "db:rls:probe": "bun scripts/probe-cross-tenant-rls.ts",
    "db:generate-auth": "bunx @better-auth/cli@latest generate --config lib/auth.ts --output db/schema/auth.ts --yes",
    "db:seed": "bun db/seed.ts",
    "check:biome": "biome check .",
    "check:biome:ci": "biome ci .",
    "trellis:todo": "mkdir -p test-results && trellis todo --output test-results/trellis-todo.json",
    "hig:audit": "bunx hig-doctor@2.0.3 . --json",
    "test:local": "node scripts/test-local.mjs"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.16",
    "@ai-sdk/react": "^4.0.23",
    "@better-auth/passkey": "1.6.23",
    "@better-auth/stripe": "1.6.23",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "ai": "^7.0.22",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-qr-code": "^2.2.0",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@raintree-technology/trellis": "0.3.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "agent-browser": "0.31.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@typescript-eslint/project-service": "8.63.0",
    "@typescript-eslint/tsconfig-utils": "8.63.0",
    "@typescript-eslint/type-utils": "8.63.0",
    "@typescript-eslint/types": "8.63.0",
    "@typescript-eslint/typescript-estree": "8.63.0",
    "@typescript-eslint/utils": "8.63.0",
    "@typescript-eslint/visitor-keys": "8.63.0",
    "brace-expansion": "5.0.9",
    "@simplewebauthn/server": "13.3.3",
    "browserslist": "4.28.8",
    "dompurify": "3.4.13",
    "esbuild": "0.28.1",
    "flatted": "3.4.2",
    "minimatch": "10.2.5",
    "picomatch": "4.0.5",
    "js-yaml": "4.3.2",
    "mermaid": "11.16.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "typescript-eslint": "8.63.0",
    "undici": "7.29.0",
    "vite": "8.1.4",
    "yaml": "2.9.0",
    "baseline-browser-mapping": "2.11.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raintree-technology/raintree-starter.git"
  }
}
